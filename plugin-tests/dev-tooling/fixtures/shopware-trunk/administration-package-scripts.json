{
  "build": "export VITE_MODE=production && ts-node -T build.ts",
  "code-mods": "node code-mods.js",
  "codemod:js-vue3-feature-flag-removal": "ts-node --transpileOnly ./scripts/codemods/js-vue3-feature-flag-removal/index.ts",
  "codemod:twig-feature-flag-removal": "ts-node --transpileOnly ./scripts/codemods/twig-feature-flag-removal/index.ts",
  "codemod:twig-remove-blocks": "ts-node --transpileOnly ./scripts/codemods/twig-block-removal/index.ts",
  "codemod:sfc-migration": "ts-node --transpileOnly ./scripts/codemods/sfc-migration/run-sfc-migration.ts",
  "convert-entity-schema": "ts-node --transpileOnly ./scripts/entitySchemaConverter/convert-schema.ts",
  "create-test": "node ./scripts/create-spec-file/index.mjs",
  "dev": "export VITE_MODE=development && ts-node -T build.ts",
  "extension-tooling:check": "ts-node --transpileOnly ./scripts/extensionTooling/check.ts",
  "extension-tooling:setup": "ts-node --transpileOnly ./scripts/extensionTooling/setup.ts",
  "format": "prettier --check \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\" \"extension-tooling/**/*.mjs\" \"scripts/extensionTooling/**/*.ts\" \"scripts/codemods/**/*.ts\" \"scripts/generate-shopware-modules/**/*.ts\" \"build/vite-plugins/**/*.{js,ts}\" \"build/vue-setup-transform/**/*.{js,ts}\" \"build/plugins.vite.ts\" \"build.ts\"",
  "format:fix": "prettier --write \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\" \"extension-tooling/**/*.mjs\" \"scripts/extensionTooling/**/*.ts\" \"scripts/codemods/**/*.ts\" \"scripts/generate-shopware-modules/**/*.ts\" \"build/vite-plugins/**/*.{js,ts}\" \"build/vue-setup-transform/**/*.{js,ts}\" \"build/plugins.vite.ts\" \"build.ts\" --cache",
  "generate-api-docs": "./node_modules/.bin/jsdoc src -r -c jsdoc.config.js",
  "generate-component-import-resolver-map": "ts-node --transpileOnly ./scripts/componentImportResolver/generate.ts",
  "generate-data-set-list": "ts-node --transpileOnly ./scripts/generate-data-set-list/index.ts",
  "generate-blocks-list": "ts-node --transpileOnly ./scripts/generate-block-list/index.ts",
  "generate-entity-schema-package": "ts-node --transpileOnly ./scripts/entitySchemaConverter/generate-package.ts",
  "generate-position-identifier-list": "ts-node --transpileOnly ./scripts/generate-position-identifier-list/index.ts",
  "generate-shopware-modules": "ts-node --transpileOnly ./scripts/generate-shopware-modules/index.ts",
  "preinstall": "node ./scripts/validate-package-json/index.mjs",
  "postinstall": "patch-package",
  "lint": "eslint src test build/vue-setup-transform build/vite-plugins/virtual-shopware-modules extension-tooling scripts/extensionTooling scripts/generate-shopware-modules scripts/codemods build.ts --cache",
  "lint:all": "npm run lint:types && npm run lint && npm run lint:scss && npm run format",
  "lint:debugging": "eslint",
  "lint:deprecations": "FILES=$(git status -s | awk '/(js|ts|vue|html\\.twig)$/ {print $2}'); [ -z \"$FILES\" ] || eslint --rule '\"sw-deprecation-rules/private-feature-declarations\": \"error\"' $FILES",
  "lint:fix": "npm run lint -- --fix",
  "lint:junit": "eslint --format junit src test build/vite-plugins/virtual-shopware-modules extension-tooling scripts/extensionTooling scripts/generate-shopware-modules scripts/codemods build.ts > eslint.junit.xml",
  "lint:scss": "stylelint **/*.scss --cache",
  "lint:scss-fix": "npm run lint:scss -- --fix",
  "lint:snippets": "eslint \"src/**/snippet/*.json\" --no-cache",
  "lint:snippets:all": "SNIPPET_ALLOW_LIST_DISABLED=1 eslint \"src/**/snippet/*.json\" --no-cache",
  "lint:test-parser": "eslint test/eslint/error-reference.html.twig --no-ignore",
  "lint:twig": "eslint src",
  "lint:types": "tsc",
  "lint-fix": "eslint --fix src test build/vite-plugins/virtual-shopware-modules extension-tooling scripts/extensionTooling scripts/generate-shopware-modules scripts/codemods build.ts",
  "security-check": "./node_modules/.bin/nsp check",
  "test-debug": "node --inspect-brk TZ=UTC node_modules/.bin/jest --watch --config jest.config.js --runInBand --no-cache",
  "unit": "jest --config jest.config.js --ci",
  "unit:extension-tooling-e2e": "EXTENSION_TOOLING_E2E=1 jest --config jest.config.js --ci --coverage=false scripts/extensionTooling/e2e.spec",
  "unit-setup": "npm run generate-component-import-resolver-map",
  "unit-watch": "jest --config jest.config.js --watch",
  "vite": "vite",
  "vite:build": "vite build",
  "perf": "lhci autorun --config=./lighthouserc.js",
  "perf:collect": "lhci collect --config=./lighthouserc.js",
  "perf:assert": "lhci assert --config=./lighthouserc.js"
}
